    </bpmn:task>
    <bpmn:endEvent id="AulaDelete_3" name="Aula indisponível ao aluno">
      <bpmn:incoming>Atual_Flow_76</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="AulaAdmin_0" name="Administrador consulta curso, módulo e aula">
      <bpmn:outgoing>Atual_Flow_77</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AulaAdmin_1" name="Listar aulas incluindo arquivadas">
