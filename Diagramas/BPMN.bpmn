  <bpmn:process id="Process_Dashboard" name="Dashboard administrativo" isExecutable="false">
    <bpmn:documentation>/administracao/dashboard e /api/administracao/dashboard. Consultas de resumo, atividade diária, matrículas por mês, cursos mais procurados e usuários por perfil. Fontes: backend/src/main/java/com/cursovalido/backend/dashboard/service/DashboardService.java; frontend/src/componentes/administracao/DashboardAdministrativo.jsx. Inventário exato de endpoints: GET /api/administracao/dashboard/resumo; GET /api/administracao/dashboard/atividade-diaria; GET /api/administracao/dashboard/matriculas-por-mes; GET /api/administracao/dashboard/cursos-mais-procurados; GET /api/administracao/dashboard/usuarios-por-perfil.</bpmn:documentation>
    <bpmn:startEvent id="Indicadores_Start" name="Administrador acessa dashboard">
      <bpmn:outgoing>Indicadores_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Indicadores_T1" name="Validar administrador e consultar resumo, atividade por data e matrículas de 1 a 24 meses">
      <bpmn:incoming>Indicadores_IntoT1</bpmn:incoming>
      <bpmn:outgoing>Indicadores_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Indicadores_T2" name="Consultar cursos mais procurados e perfis de usuários">
      <bpmn:incoming>Indicadores_IntoT2</bpmn:incoming>
      <bpmn:outgoing>Indicadores_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Indicadores_T3" name="Exibir totais e gráficos">
      <bpmn:documentation>Responsabilidade: Frontend: componentes CoreUI e gráficos Chart.js.</bpmn:documentation>
      <bpmn:incoming>Indicadores_IntoT3</bpmn:incoming>
      <bpmn:outgoing>Indicadores_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Indicadores_End" name="Dashboard exibido">
      <bpmn:incoming>Indicadores_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Indicadores_IntoT1" sourceRef="Indicadores_Start" targetRef="Indicadores_T1" />
    <bpmn:sequenceFlow id="Indicadores_IntoT2" sourceRef="Indicadores_T1" targetRef="Indicadores_T2" />
    <bpmn:sequenceFlow id="Indicadores_IntoT3" sourceRef="Indicadores_T2" targetRef="Indicadores_T3" />
    <bpmn:sequenceFlow id="Indicadores_Finish" sourceRef="Indicadores_T3" targetRef="Indicadores_End" />
  </bpmn:process>
  <bpmn:process id="Process_Denuncias" name="Denúncias e análise do fórum" isExecutable="false">
    <bpmn:documentation>POST /api/forum/topicos/{id}/denuncias e /comentarios/{id}/denuncias; GET/PUT /api/administracao/forum/denuncias[/{id}]. Telas /forum e /administracao/forum/denuncias. Fontes: forum/service/DenunciaForumService.java; frontend/src/componentes/forum/componentes/FormularioDenuncia.jsx e componentes/administracao/DenunciasForum.jsx. Denunciante deve estar ativo; não pode denunciar conteúdo próprio e deve aguardar 10 minutos para denunciar o mesmo autor novamente. Inventário exato de endpoints: POST /api/forum/topicos/{id}/denuncias; POST /api/forum/comentarios/{id}/denuncias; GET /api/administracao/forum/denuncias; PUT /api/administracao/forum/denuncias/{id}.</bpmn:documentation>
    <bpmn:startEvent id="DenReport_0" name="Usuário autenticado denuncia tópico ou comentário">
      <bpmn:outgoing>Atual_Flow_115</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="DenReport_1" name="Validar participante e conteúdo ativos; impedir denúncia própria">
      <bpmn:incoming>Atual_Flow_115</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_116</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DenReport_2" name="Exigir intervalo de 10 minutos por denunciante e autor denunciado">
      <bpmn:incoming>Atual_Flow_116</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_191</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DenReport_3" name="Salvar motivo e descrição opcional como PENDENTE e auditar">
      <bpmn:incoming>Atual_Flow_192</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_118</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DenReport_4" name="Denúncia enviada para análise">
      <bpmn:incoming>Atual_Flow_118</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="DenReview_0" name="Administrador abre denúncias">
      <bpmn:outgoing>Atual_Flow_119</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="DenReview_1" name="Consultar denúncias por status, conteúdo e quantidade de pendências">
      <bpmn:incoming>Atual_Flow_119</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_120</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DenReview_2" name="Selecionar denúncia PENDENTE e decidir procedência com observação; denúncia já analisada é recusada">
      <bpmn:incoming>Atual_Flow_120</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_121</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DenReview_3" name="Se procedente, permitir remoção e ou restrição CONTA ou FORUM ao autor">
      <bpmn:incoming>Atual_Flow_121</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_122</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DenReview_4" name="Aplicar restrição conforme privilégios; se remover, inativar conteúdo e encerrar todas as denúncias pendentes dele">
      <bpmn:incoming>Atual_Flow_122</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_123</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DenReview_5" name="Salvar decisão e auditar">
      <bpmn:incoming>Atual_Flow_123</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_124</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="DenReview_6" name="Análise registrada">
      <bpmn:incoming>Atual_Flow_124</bpmn:incoming>
    </bpmn:endEvent>
