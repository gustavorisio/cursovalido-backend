  </bpmn:process>
  <bpmn:process id="Process_BackendRequisicao" name="Backend Spring Boot segurança e execução das requisições" isExecutable="false">
    <bpmn:documentation>Fluxo lógico descritivo dos controles compartilhados, não uma especificação da ordenação interna de todos os filtros Spring. Fontes: forum/configuration/SecurityConfig.java; authentication/configuration/HttpsFilter.java, LimiteRequisicoesFilter.java, TokenJwtFilter.java; authentication/service/TokenJwtService.java e UsuarioDetalhesService.java; controllers, DTOs, serviços, repositories e handlers de exceção. Rotas são permitidas por lista explícita; demais rotas são negadas. Sessão Spring HTTP é STATELESS, mas o JWT é associado a uma sessão própria persistida, com validade e revogação verificadas. HTTPS é obrigatório no perfil prod e configurável no padrão. CORS admite origens configuradas. Operações podem devolver códigos distintos conforme as exceções; os resultados BPMN agrupam categorias de recusa. Persistência utiliza PostgreSQL; entidades JPA/Hibernate e componentes JDBC conforme o módulo. Integrações possuem credenciais externas mantidas no servidor. Não são adicionados serviços de CEP, aplicativo móvel, certificados ou infraestrutura dos diagramas de referência.</bpmn:documentation>
    <bpmn:startEvent id="Api_Start" name="Requisição de rota protegida">
      <bpmn:outgoing>Api_MainF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Api_Filtros" name="Aplicar HTTPS, CORS e limites de requisições e tentativas">
      <bpmn:incoming>Api_MainF1</bpmn:incoming>
      <bpmn:outgoing>Api_MainF2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Api_Limites" name="Entrada permitida?">
      <bpmn:incoming>Api_MainF2</bpmn:incoming>
      <bpmn:outgoing>Api_MainF3</bpmn:outgoing>
      <bpmn:outgoing>Api_RecusaFiltro_F</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Api_Jwt" name="Verificar assinatura, expiração, usuário e sessão persistida do JWT">
      <bpmn:incoming>Api_MainF3</bpmn:incoming>
      <bpmn:outgoing>Api_MainF4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Api_Autenticado" name="Autenticado?">
      <bpmn:incoming>Api_MainF4</bpmn:incoming>
      <bpmn:outgoing>Api_MainF5</bpmn:outgoing>
      <bpmn:outgoing>Api_RecusaAutenticacao_F</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Api_Permissoes" name="Verificar conta, documentos, escopo do token e permissão da rota">
      <bpmn:incoming>Api_MainF5</bpmn:incoming>
      <bpmn:outgoing>Api_MainF6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Api_Autorizado" name="Acesso permitido?">
      <bpmn:incoming>Api_MainF6</bpmn:incoming>
      <bpmn:outgoing>Api_MainF7</bpmn:outgoing>
      <bpmn:outgoing>Api_RecusaPermissao_F</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Api_Entrada" name="Controller converte DTO e aplica Bean Validation">
      <bpmn:incoming>Api_MainF7</bpmn:incoming>
      <bpmn:outgoing>Api_MainF8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Api_Dados" name="Entrada válida?">
      <bpmn:incoming>Api_MainF8</bpmn:incoming>
      <bpmn:outgoing>Api_MainF9</bpmn:outgoing>
      <bpmn:outgoing>Api_RecusaValidacao_F</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Api_Servico" name="Executar regra de negócio, persistência e integrações aplicáveis">
      <bpmn:incoming>Api_MainF9</bpmn:incoming>
      <bpmn:outgoing>Api_MainF10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Api_End" name="Resposta HTTP com JSON">
      <bpmn:incoming>Api_MainF10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Api_RecusaFiltro" name="Recusar transporte, origem ou excesso de requisições">
      <bpmn:incoming>Api_RecusaFiltro_F</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Api_RecusaAutenticacao" name="Recusar acesso sem autenticação válida (401)">
      <bpmn:incoming>Api_RecusaAutenticacao_F</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Api_RecusaPermissao" name="Recusar acesso ou exigir regularização de documentos (403)">
      <bpmn:incoming>Api_RecusaPermissao_F</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Api_RecusaValidacao" name="Recusar JSON, campos ou parâmetros inválidos (400)">
      <bpmn:incoming>Api_RecusaValidacao_F</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Api_Publica_0" name="Requisição de endpoint público">
      <bpmn:outgoing>Api_Publica_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Api_Publica_1" name="Aplicar filtros de transporte, origem e limites compatíveis com a rota">
      <bpmn:incoming>Api_Publica_F1</bpmn:incoming>
      <bpmn:outgoing>Api_Publica_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Api_Publica_2" name="Conferir rota pública permitida e validar parâmetros ou DTO">
      <bpmn:incoming>Api_Publica_F2</bpmn:incoming>
      <bpmn:outgoing>Api_Publica_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Api_Publica_3" name="Executar catálogo, documentos, cadastro, login, convite ou suporte solicitado">
      <bpmn:incoming>Api_Publica_F3</bpmn:incoming>
      <bpmn:outgoing>Api_Publica_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Api_Publica_4" name="Resposta pública sem exigir sessão de acesso">
      <bpmn:incoming>Api_Publica_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Api_RecusaNegocio_0" name="Regra de negócio ou integração recusa operação">
      <bpmn:outgoing>Api_RecusaNegocio_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Api_RecusaNegocio_1" name="Tratar a exceção e preservar as garantias transacionais do fluxo">
      <bpmn:incoming>Api_RecusaNegocio_F1</bpmn:incoming>
      <bpmn:outgoing>Api_RecusaNegocio_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Api_RecusaNegocio_2" name="Devolver status e mensagem correspondentes; não informar sucesso sem conclusão">
      <bpmn:incoming>Api_RecusaNegocio_F2</bpmn:incoming>
      <bpmn:outgoing>Api_RecusaNegocio_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Api_RecusaNegocio_3" name="Frontend recebe erro tratável">
      <bpmn:incoming>Api_RecusaNegocio_F3</bpmn:incoming>
    </bpmn:endEvent>
