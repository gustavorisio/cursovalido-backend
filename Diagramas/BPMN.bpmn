      <bpmn:outgoing>Atual_Flow_138</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Rank_4" name="Exibir tabela do ranking">
      <bpmn:incoming>Atual_Flow_138</bpmn:incoming>
    </bpmn:endEvent>
