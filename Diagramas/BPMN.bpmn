  <bpmn:process id="Process_Comunicados" name="Comunicados e notificações" isExecutable="false">
    <bpmn:documentation>Administração em /administracao/comunicados e /api/administracao/comunicados. Usuários autenticados consultam /notificacoes e /api/notificacoes. A abertura de um comunicado registra leitura individual. Fontes: backend/src/main/java/com/cursovalido/backend/notificacoes/service/ComunicadoService.java; frontend/src/componentes/notificacoes/PaginaNotificacoes.jsx; SinoNotificacoes.jsx. Inventário exato de endpoints: POST /api/administracao/comunicados; PUT /api/administracao/comunicados/{id}; DELETE /api/administracao/comunicados/{id}; GET /api/administracao/comunicados; GET /api/notificacoes; GET /api/aluno/notificacoes; GET /api/notificacoes/nao-lidas; GET /api/aluno/notificacoes/nao-lidas; PUT /api/notificacoes/{id}/lida; PUT /api/aluno/notificacoes/{id}/lida. A consulta é paginada, com leitura individual e contagem de não lidas. Não se acrescentam limite global de 30 comunicados ou intervalo de publicação de 30 segundos: essas restrições não constam no ComunicadoService/ComunicadoRepository nem nas duas migrações presentes nesta cópia do projeto.</bpmn:documentation>
    <bpmn:startEvent id="PublicarComunicado_Start" name="Administrador publica comunicado">
      <bpmn:outgoing>PublicarComunicado_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="PublicarComunicado_T1" name="Preencher título e conteúdo">
      <bpmn:incoming>PublicarComunicado_IntoT1</bpmn:incoming>
      <bpmn:outgoing>PublicarComunicado_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PublicarComunicado_T2" name="Validar administrador ativo e campos">
      <bpmn:incoming>PublicarComunicado_IntoT2</bpmn:incoming>
      <bpmn:outgoing>PublicarComunicado_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PublicarComunicado_T3" name="Salvar e auditar publicação">
      <bpmn:incoming>PublicarComunicado_IntoT3</bpmn:incoming>
      <bpmn:outgoing>PublicarComunicado_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="PublicarComunicado_End" name="Comunicado disponível">
      <bpmn:incoming>PublicarComunicado_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="GerirComunicado_Start" name="Administrador gerencia comunicado">
      <bpmn:outgoing>GerirComunicado_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="GerirComunicado_T1" name="Consultar e selecionar comunicado">
      <bpmn:incoming>GerirComunicado_IntoT1</bpmn:incoming>
      <bpmn:outgoing>GerirComunicado_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GerirComunicado_T2" name="Editar texto ou confirmar a exclusão">
      <bpmn:incoming>GerirComunicado_IntoT2</bpmn:incoming>
      <bpmn:outgoing>GerirComunicado_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="GerirComunicado_T3" name="Persistir alteração, ou excluir comunicado e leituras, e auditar">
      <bpmn:incoming>GerirComunicado_IntoT3</bpmn:incoming>
      <bpmn:outgoing>GerirComunicado_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="GerirComunicado_End" name="Lista atualizada">
      <bpmn:incoming>GerirComunicado_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="LerComunicado_Start" name="Usuário autenticado consulta notificações">
      <bpmn:outgoing>LerComunicado_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="LerComunicado_T1" name="Atualizar contador de não lidas e carregar a lista">
      <bpmn:incoming>LerComunicado_IntoT1</bpmn:incoming>
      <bpmn:outgoing>LerComunicado_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LerComunicado_T2" name="Abrir comunicado selecionado">
      <bpmn:incoming>LerComunicado_IntoT2</bpmn:incoming>
      <bpmn:outgoing>LerComunicado_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LerComunicado_T3" name="Registrar leitura individual e atualizar contador">
      <bpmn:incoming>LerComunicado_IntoT3</bpmn:incoming>
      <bpmn:outgoing>LerComunicado_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="LerComunicado_End" name="Comunicado lido">
      <bpmn:incoming>LerComunicado_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PublicarComunicado_IntoT1" sourceRef="PublicarComunicado_Start" targetRef="PublicarComunicado_T1" />
    <bpmn:sequenceFlow id="PublicarComunicado_IntoT2" sourceRef="PublicarComunicado_T1" targetRef="PublicarComunicado_T2" />
