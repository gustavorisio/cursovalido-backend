<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CursoValido" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.33.1">
  <bpmn:collaboration id="Collaboration_CursoValido">
    <bpmn:documentation>Revisão incremental em 22/11/2026 a partir do arquivo fornecido, preservando os 21 processos originais, seus identificadores e posições relativas. Modelo BPMN 2.0 descritivo, não executável. Cada evento inicial representa uma operação independente. Os pools organizam domínios do mesmo sistema e não representam microsserviços. Foram acrescentados fluxos transversais da interface React e da API Spring Boot. As atividades usam tarefas genéricas, sem ícones internos. As responsabilidades de backend e frontend estão indicadas nos nomes e na documentação dos processos. Os gateways exclusivos são exibidos como losangos sem marcador interno. A situação observada no código local prevalece sobre descrições desatualizadas. Resíduos sem endpoint funcional não são representados como funcionalidades disponíveis. Aprovação de equipe é preservada apenas para pendências legadas ainda atendidas no painel e na API. A validação é do modelo e de sua renderização; não representa execução de todos os testes do sistema. Revisão de 23/11/2026 conferida com o backend e o frontend locais: inventário de endpoints do fórum, auditoria das operações do fórum e recusa de denúncia já analisada.</bpmn:documentation>
    <bpmn:participant id="Participant_Cadastro" name="Cadastro público de aluno" processRef="Process_Cadastro" />
    <bpmn:participant id="Participant_Login" name="Login, confirmação por código e sessão" processRef="Process_Login" />
    <bpmn:participant id="Participant_Senha" name="Recuperação de senha" processRef="Process_Senha" />
    <bpmn:participant id="Participant_Termos" name="Termos e conta" processRef="Process_Termos" />
    <bpmn:participant id="Participant_Politicas" name="Políticas" processRef="Process_Politicas" />
    <bpmn:participant id="Participant_Convites" name="Convites de equipe e pendências legadas" processRef="Process_Convites" />
    <bpmn:participant id="Participant_Forum" name="Fórum privado e participação autenticada" processRef="Process_Forum" />
    <bpmn:participant id="Participant_Cursos" name="Cursos" processRef="Process_Cursos" />
    <bpmn:participant id="Participant_Modulos" name="Módulos" processRef="Process_Modulos" />
    <bpmn:participant id="Participant_Aulas" name="Aulas, provedores de vídeo e progresso" processRef="Process_Aulas" />
    <bpmn:participant id="Participant_Matriculas" name="Matrículas" processRef="Process_Matriculas" />
    <bpmn:participant id="Participant_Suporte" name="Suporte público" processRef="Process_Suporte" />
    <bpmn:participant id="Participant_Aprendizagem" name="Avaliações de curso, questionários e plano de estudos" processRef="Process_Aprendizagem" />
    <bpmn:participant id="Participant_Comunicados" name="Comunicados e notificações" processRef="Process_Comunicados" />
    <bpmn:participant id="Participant_Moderacao" name="Moderação de contas e restrições" processRef="Process_Moderacao" />
    <bpmn:participant id="Participant_Dashboard" name="Dashboard administrativo" processRef="Process_Dashboard" />
    <bpmn:participant id="Participant_Denuncias" name="Denúncias e análise do fórum" processRef="Process_Denuncias" />
    <bpmn:participant id="Participant_Gamificacao" name="Conclusão de cursos, XP e níveis" processRef="Process_Gamificacao" />
    <bpmn:participant id="Participant_Ranking" name="Ranking de alunos" processRef="Process_Ranking" />
    <bpmn:participant id="Participant_VideoInicio" name="Vídeo de apresentação da página inicial" processRef="Process_VideoInicio" />
    <bpmn:participant id="Participant_Inicializacao" name="Inicialização do administrador principal" processRef="Process_Inicializacao" />
    <bpmn:participant id="Participant_FrontendSessao" name="Frontend React navegação, sessão e comunicação HTTP" processRef="Process_FrontendSessao" />
    <bpmn:participant id="Participant_BackendRequisicao" name="Backend Spring Boot segurança e execução das requisições" processRef="Process_BackendRequisicao" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Cadastro" name="Cadastro público de aluno" isExecutable="false">
    <bpmn:documentation>Tela /cadastro; POST /api/autenticacao/cadastro. Fontes: frontend/src/paginas/Cadastro.jsx e servicos/servicoAutenticacao.js; backend/src/main/java/com/cursovalido/backend/authentication/service/CadastroUsuarioService.java, entity/Usuario.java, validation/cadastro/CadastroValidation.java e dto/CadastroUsuarioRequest.java. O cadastro não envia código nem aplica limite específico de cadastros por IP; aplica-se o filtro geral de requisições. O código para confirmar o e-mail é solicitado no login. Inventário exato de endpoints: POST /api/autenticacao/cadastro.</bpmn:documentation>
    <bpmn:startEvent id="Cad_0" name="Visitante abre /cadastro">
      <bpmn:outgoing>Atual_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Cad_1" name="Carregar termos vigentes e preencher dados, senha, maioridade e aceite">
      <bpmn:documentation>Responsabilidade: Usuário na interface React.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Cad_2" name="Validar formulário, domínio de e-mail, unicidade, senha e versão dos termos">
      <bpmn:documentation>Responsabilidade: Backend: validações da requisição e do domínio.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_161</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Cad_3" name="Gerar RA único e criar ALUNO ativo e APROVADO, com e-mail não confirmado e 2FA desativado">
      <bpmn:documentation>Responsabilidade: Backend: cadastro e persistência.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_162</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Cad_4" name="Salvar senha BCrypt, gerar gamertag e registrar aceite">
      <bpmn:documentation>Responsabilidade: Backend: BCrypt, gamertag e aceite.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Cad_5" name="Auditar CADASTRO_USUARIO">
      <bpmn:documentation>Responsabilidade: Backend: auditoria.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_5</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Cad_6" name="Redirecionar para /login">
      <bpmn:incoming>Atual_Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Cad_Valido" name="Dados e aceite válidos?">
      <bpmn:incoming>Atual_Flow_161</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_162</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_163</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Cad_Valido_Recusa" name="Cadastro recusado">
      <bpmn:incoming>Atual_Flow_163</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Atual_Flow_1" sourceRef="Cad_0" targetRef="Cad_1" />
    <bpmn:sequenceFlow id="Atual_Flow_2" sourceRef="Cad_1" targetRef="Cad_2" />
    <bpmn:sequenceFlow id="Atual_Flow_161" sourceRef="Cad_2" targetRef="Cad_Valido" />
    <bpmn:sequenceFlow id="Atual_Flow_162" name="Sim" sourceRef="Cad_Valido" targetRef="Cad_3" />
    <bpmn:sequenceFlow id="Atual_Flow_4" sourceRef="Cad_3" targetRef="Cad_4" />
    <bpmn:sequenceFlow id="Atual_Flow_5" sourceRef="Cad_4" targetRef="Cad_5" />
    <bpmn:sequenceFlow id="Atual_Flow_6" sourceRef="Cad_5" targetRef="Cad_6" />
    <bpmn:sequenceFlow id="Atual_Flow_163" name="Não" sourceRef="Cad_Valido" targetRef="Cad_Valido_Recusa" />
  </bpmn:process>
  <bpmn:process id="Process_Login" name="Login, confirmação por código e sessão" isExecutable="false">
    <bpmn:documentation>Tela /login; POST /api/autenticacao/login, /confirmar-2fa, /reenviar-2fa e /logout. Fontes: authentication/service/AutenticacaoService.java, EnvioCodigo2faService.java, TokenEmailService.java e validation/login/AutenticacaoValidation.java; frontend/src/paginas/Login.jsx e contextos/ContextoAutenticacao.jsx. O identificador de proteção contra força bruta é o e-mail normalizado. Equipe sempre usa 2FA; aluno confirmado com 2FA desativado entra sem código. O principal dispensa a verificação de aceite vigente. Inventário exato de endpoints: POST /api/autenticacao/logout; POST /api/autenticacao/login; POST /api/autenticacao/confirmar-2fa; POST /api/autenticacao/reenviar-2fa. Sessões: cada emissão de JWT normal ou restrito revoga as sessões anteriores da mesma conta. JWT normal possui expiração configurável; o restrito aos documentos dura 5 minutos. O frontend conserva a sessão em localStorage, sincroniza abas e descarta respostas de autenticações abandonadas. Fontes complementares: authentication/service/TokenJwtService.java; frontend/src/contextos/AutenticacaoContexto.jsx e servicos/sessaoNavegador.js.</bpmn:documentation>
    <bpmn:startEvent id="LoginA_0" name="Usuário informa e-mail e senha">
      <bpmn:outgoing>Atual_Flow_7</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="LoginA_1" name="Verificar bloqueio de tentativas e credenciais BCrypt">
      <bpmn:documentation>Falhas de senha/código registram tentativas e auditoria. Bloqueio, conta inativa, pendente, rejeitada ou suspensa impedem o login; nenhum JWT de acesso é emitido.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_7</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_164</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LoginA_2" name="Validar conta ativa, status APROVADO e ausência de suspensão CONTA">
      <bpmn:incoming>Atual_Flow_165</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_167</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Login_Codigo" name="Equipe, 2FA ativo ou e-mail não confirmado?">
      <bpmn:incoming>Atual_Flow_168</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Login_Send" name="Gerar e enviar código de 6 dígitos, válido por 10 minutos">
      <bpmn:incoming>Atual_Flow_10</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Login_Wait" name="Solicitar código na tela de login">
      <bpmn:incoming>Atual_Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Login_Merge" name="Concluir autenticação">
      <bpmn:incoming>Atual_Flow_12</bpmn:incoming>
      <bpmn:incoming>Atual_Flow_16</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="LoginCode_0" name="Usuário informa o código recebido">
      <bpmn:outgoing>Atual_Flow_13</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="LoginCode_1" name="Verificar bloqueio e conferir código sem consumir">
      <bpmn:incoming>Atual_Flow_13</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_170</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LoginCode_2" name="Validar situação da conta antes de consumir o código">
      <bpmn:incoming>Atual_Flow_171</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_173</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LoginCode_3" name="Consumir código, revalidar conta e confirmar e-mail pendente">
      <bpmn:incoming>Atual_Flow_174</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Login_Terms" name="Principal ou aceite vigente?">
      <bpmn:incoming>Atual_Flow_17</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Login_Restricted" name="JWT restrito aos documentos emitido por 5 minutos">
      <bpmn:incoming>Atual_Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Login_Issue" name="Sincronizar fórum e auditar LOGIN; emitir JWT e revogar sessões anteriores">
      <bpmn:incoming>Atual_Flow_19</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Login_OK" name="Guardar sessão em localStorage e liberar navegação conforme perfil">
      <bpmn:incoming>Atual_Flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="LoginResend_0" name="Usuário solicita reenvio do código">
      <bpmn:outgoing>Atual_Flow_21</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="LoginResend_1" name="Verificar conta ativa e aprovada, suspensão e necessidade de código">
      <bpmn:incoming>Atual_Flow_21</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_22</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LoginResend_2" name="Exigir código anterior não consumido e intervalo de 60 segundos; aplicar limites de tokens">
      <bpmn:incoming>Atual_Flow_22</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LoginResend_3" name="Invalidar código anterior, gerar novo e enviar e-mail se elegível">
      <bpmn:incoming>Atual_Flow_23</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="LoginResend_4" name="Retornar resposta de reenvio">
      <bpmn:incoming>Atual_Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="LoginLogout_0" name="Usuário escolhe sair">
      <bpmn:outgoing>Atual_Flow_25</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="LoginLogout_1" name="Revogar sessão JWT e auditar LOGOUT">
      <bpmn:incoming>Atual_Flow_25</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="LoginLogout_2" name="Limpar sessão no navegador">
      <bpmn:incoming>Atual_Flow_26</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="LoginLogout_3" name="Sessão encerrada">
      <bpmn:incoming>Atual_Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Login_Credenciais" name="Tentativas permitidas e senha válida?">
      <bpmn:incoming>Atual_Flow_164</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_165</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_166</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Login_Credenciais_Recusa" name="Login recusado ou temporariamente bloqueado">
      <bpmn:incoming>Atual_Flow_166</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Login_Conta" name="Conta ativa, aprovada e sem suspensão CONTA?">
      <bpmn:incoming>Atual_Flow_167</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_168</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_169</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Login_Conta_Recusa" name="Acesso recusado, pendente ou rejeitado">
      <bpmn:incoming>Atual_Flow_169</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Login_CodeValid" name="Código válido e tentativas permitidas?">
      <bpmn:incoming>Atual_Flow_170</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_171</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_172</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Login_CodeValid_Recusa" name="Código recusado, expirado ou temporariamente bloqueado">
      <bpmn:incoming>Atual_Flow_172</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Login_CodeAccount" name="Conta apta para confirmação?">
      <bpmn:incoming>Atual_Flow_173</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_174</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_175</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Login_CodeAccount_Recusa" name="Acesso recusado sem consumir código">
      <bpmn:incoming>Atual_Flow_175</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Atual_Flow_7" sourceRef="LoginA_0" targetRef="LoginA_1" />
    <bpmn:sequenceFlow id="Atual_Flow_164" sourceRef="LoginA_1" targetRef="Login_Credenciais" />
    <bpmn:sequenceFlow id="Atual_Flow_165" name="Sim" sourceRef="Login_Credenciais" targetRef="LoginA_2" />
    <bpmn:sequenceFlow id="Atual_Flow_167" sourceRef="LoginA_2" targetRef="Login_Conta" />
    <bpmn:sequenceFlow id="Atual_Flow_168" name="Sim" sourceRef="Login_Conta" targetRef="Login_Codigo" />
    <bpmn:sequenceFlow id="Atual_Flow_10" name="Sim" sourceRef="Login_Codigo" targetRef="Login_Send" />
    <bpmn:sequenceFlow id="Atual_Flow_12" name="Não" sourceRef="Login_Codigo" targetRef="Login_Merge" />
    <bpmn:sequenceFlow id="Atual_Flow_11" sourceRef="Login_Send" targetRef="Login_Wait" />
    <bpmn:sequenceFlow id="Atual_Flow_16" sourceRef="LoginCode_3" targetRef="Login_Merge" />
    <bpmn:sequenceFlow id="Atual_Flow_17" sourceRef="Login_Merge" targetRef="Login_Terms" />
    <bpmn:sequenceFlow id="Atual_Flow_13" sourceRef="LoginCode_0" targetRef="LoginCode_1" />
    <bpmn:sequenceFlow id="Atual_Flow_170" sourceRef="LoginCode_1" targetRef="Login_CodeValid" />
    <bpmn:sequenceFlow id="Atual_Flow_171" name="Sim" sourceRef="Login_CodeValid" targetRef="LoginCode_2" />
    <bpmn:sequenceFlow id="Atual_Flow_173" sourceRef="LoginCode_2" targetRef="Login_CodeAccount" />
    <bpmn:sequenceFlow id="Atual_Flow_174" name="Sim" sourceRef="Login_CodeAccount" targetRef="LoginCode_3" />
    <bpmn:sequenceFlow id="Atual_Flow_18" name="Não" sourceRef="Login_Terms" targetRef="Login_Restricted" />
