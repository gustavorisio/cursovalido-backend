    </bpmn:endEvent>
    <bpmn:startEvent id="Term_AcceptStart" name="Usuário confirma documentos com JWT restrito após login">
      <bpmn:outgoing>Term_F5</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Term_CheckActive" name="Validar sessão restrita e versões vigentes">
      <bpmn:incoming>Term_F5</bpmn:incoming>
      <bpmn:outgoing>Term_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Term_Version" name="Versão ativa válida?">
      <bpmn:incoming>Term_F6</bpmn:incoming>
      <bpmn:outgoing>Term_F7</bpmn:outgoing>
      <bpmn:outgoing>Term_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Term_VersionError" name="Aceite recusado">
      <bpmn:incoming>Term_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Term_Accept" name="Validar aceite de responsabilidade quando exigido e arquivar aceite anterior">
      <bpmn:incoming>Term_F8</bpmn:incoming>
      <bpmn:outgoing>Term_F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Term_Reactive" name="Registrar versão e data do novo aceite">
