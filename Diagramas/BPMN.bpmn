      <bpmn:incoming>Term_F1</bpmn:incoming>
      <bpmn:outgoing>Term_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Term_RevSync" name="Revogar sessões e códigos e sincronizar dados no fórum">
