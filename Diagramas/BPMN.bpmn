  <bpmn:process id="Process_Gamificacao" name="Conclusão de cursos, XP e níveis" isExecutable="false">
    <bpmn:documentation>GET /api/aluno/gamificacao; recompensa também retornada em POST /api/aluno/aulas/{idAula}/conclusao. Fontes: aulas/service/GamificacaoService.java, ProgressaoNivel.java, SincronizacaoGamificacao.java e ProgressoAulaService.java; frontend/src/componentes/aulas/componentes/PainelNivel.jsx e PaginaAulaAluno.jsx. XP por curso = min(100 + 10 × aulas ativas, 500), uma única vez por aluno e curso. Nível inicial 1, máximo 100. Meta = max(100, round(100 × 1,5^(nível−1) / 10) × 10). Inventário exato de endpoints: GET /api/aluno/gamificacao.</bpmn:documentation>
    <bpmn:startEvent id="XP_0" name="Aluno consulta gamificação ou conclui aula">
      <bpmn:outgoing>Atual_Flow_125</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="XP_1" name="Verificar matrícula, curso ativo e ao menos uma aula ativa">
      <bpmn:incoming>Atual_Flow_125</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_126</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XP_2" name="Conferir se todas as aulas ativas foram concluídas e se o curso ainda não rendeu XP">
      <bpmn:incoming>Atual_Flow_126</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_188</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XP_3" name="Quando elegível, conceder 100 XP mais 10 por aula ativa, até 500 XP, uma vez por curso">
      <bpmn:documentation>Quando ainda há aula pendente, o curso não tem aulas ou a recompensa já foi registrada, não se concede novo XP; a consulta mantém o resumo atual.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_189</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_128</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XP_4" name="Atualizar saldo, XP total e subir níveis conforme metas, até o nível 100">
      <bpmn:incoming>Atual_Flow_128</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_129</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XP_5" name="Auditar nova conclusão e retornar situação e eventual recompensa">
      <bpmn:incoming>Atual_Flow_129</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_130</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="XP_6" name="Exibir nível, progresso de XP e cursos concluídos">
      <bpmn:incoming>Atual_Flow_130</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="XPStartup_0" name="Backend conclui inicialização fora do perfil test">
      <bpmn:outgoing>Atual_Flow_131</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="XPStartup_1" name="Localizar matrículas sem conclusão de curso registrada">
      <bpmn:incoming>Atual_Flow_131</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_132</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XPStartup_2" name="Reavaliar conclusões antigas e conceder XP apenas quando elegíveis">
      <bpmn:incoming>Atual_Flow_132</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_133</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="XPStartup_3" name="Registrar resultado ou falhas no log">
