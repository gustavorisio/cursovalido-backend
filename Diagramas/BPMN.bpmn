      <bpmn:incoming>Atual_Flow_99</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_100</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ModSuspend_2" name="Escolher CONTA ou FORUM, motivo e prazo futuro ou permanente">
      <bpmn:incoming>Atual_Flow_100</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_101</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ModSuspend_3" name="Revogar suspensão vigente do mesmo escopo e salvar nova">
      <bpmn:incoming>Atual_Flow_101</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_102</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ModSuspend_4" name="Revogar sessões e códigos de acesso e auditar">
      <bpmn:incoming>Atual_Flow_102</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_103</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ModSuspend_5" name="Restringir conta inteira ou acesso ao fórum">
      <bpmn:incoming>Atual_Flow_103</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ModRevoke_0" name="Administrador revoga suspensão">
      <bpmn:outgoing>Atual_Flow_104</bpmn:outgoing>
    </bpmn:startEvent>
