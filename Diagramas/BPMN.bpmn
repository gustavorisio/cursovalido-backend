  <bpmn:process id="Process_Cursos" name="Catálogo e gestão de cursos gratuitos" isExecutable="false">
    <bpmn:documentation>Catálogo público /cursos e GET /api/catalogo/cursos e /api/catalogo/temas. Área do estudante /aluno/cursos. Gestão do professor em /professor/cursos e /api/cursos. Administração em /administracao/cursos e /api/administracao/cursos. Fontes: backend/src/main/java/com/cursovalido/backend/aulas/service/CursoService.java; aulas/service/TemaService.java; aulas/service/AdministradorAulasService.java; frontend/src/componentes/aulas/InicioCursos.jsx; PaginaCatalogo.jsx; PaginaGestaoCursos.jsx; PaginaAulasAdministrador.jsx. Inventário exato de endpoints: PUT /api/administracao/cursos/{id}; DELETE /api/administracao/cursos/{id}; GET /api/administracao/cursos; GET /api/administracao/cursos/{id}; GET /api/catalogo/cursos; GET /api/cursos; GET /api/cursos/{id}; POST /api/cursos; PUT /api/cursos/{id}; DELETE /api/cursos/{id}; GET /api/catalogo/temas; POST /api/temas; PUT /api/temas/{id}; DELETE /api/temas/{id}.</bpmn:documentation>
    <bpmn:startEvent id="Cur_Start" name="Visitante ou aluno abre o catálogo">
      <bpmn:outgoing>Cur_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Cur_List" name="Listar cursos ativos por busca e tema">
      <bpmn:incoming>Cur_F1</bpmn:incoming>
      <bpmn:outgoing>Cur_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Cur_Select" name="Selecionar curso e consultar disponibilidade">
      <bpmn:incoming>Cur_F2</bpmn:incoming>
      <bpmn:outgoing>Cur_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Cur_End" name="Curso exibido. Matrícula exige perfil de aluno">
      <bpmn:incoming>Cur_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ProfessorCurso_Start" name="Professor abre gestão de cursos">
      <bpmn:outgoing>ProfessorCurso_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="ProfessorCurso_T1" name="Listar cursos sob sua autoria">
      <bpmn:incoming>ProfessorCurso_IntoT1</bpmn:incoming>
      <bpmn:outgoing>ProfessorCurso_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ProfessorCurso_T2" name="Cadastrar, editar ou excluir curso próprio">
      <bpmn:incoming>ProfessorCurso_IntoT2</bpmn:incoming>
      <bpmn:outgoing>ProfessorCurso_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ProfessorCurso_T3" name="Validar campos, capa JPEG, autoria e tema; salvar ou inativar e auditar">
      <bpmn:incoming>ProfessorCurso_IntoT3</bpmn:incoming>
      <bpmn:outgoing>ProfessorCurso_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ProfessorCurso_End" name="Catálogo atualizado">
      <bpmn:incoming>ProfessorCurso_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="AdminCurso_Start" name="Administrador abre gestão de cursos">
      <bpmn:outgoing>AdminCurso_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AdminCurso_T1" name="Consultar cursos e detalhes">
      <bpmn:incoming>AdminCurso_IntoT1</bpmn:incoming>
      <bpmn:outgoing>AdminCurso_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AdminCurso_T2" name="Editar ou solicitar exclusão de curso">
      <bpmn:incoming>AdminCurso_IntoT2</bpmn:incoming>
      <bpmn:outgoing>AdminCurso_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AdminCurso_T3" name="Validar a edição ou inativar o curso e bloquear acesso às aulas">
      <bpmn:incoming>AdminCurso_IntoT3</bpmn:incoming>
      <bpmn:outgoing>AdminCurso_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AdminCurso_End" name="Operação concluída">
      <bpmn:incoming>AdminCurso_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Temas_Start" name="Usuário da gestão acessa temas">
      <bpmn:outgoing>Temas_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Temas_T1" name="Consultar temas do catálogo">
      <bpmn:incoming>Temas_IntoT1</bpmn:incoming>
      <bpmn:outgoing>Temas_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Temas_T2" name="Cadastrar, editar ou excluir tema conforme permissão">
      <bpmn:incoming>Temas_IntoT2</bpmn:incoming>
      <bpmn:outgoing>Temas_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Temas_T3" name="Validar nome único; ao excluir, desvincular tema dos cursos e apagar tema">
      <bpmn:incoming>Temas_IntoT3</bpmn:incoming>
      <bpmn:outgoing>Temas_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Temas_End" name="Temas atualizados">
      <bpmn:incoming>Temas_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Cur_F1" sourceRef="Cur_Start" targetRef="Cur_List" />
    <bpmn:sequenceFlow id="Cur_F2" sourceRef="Cur_List" targetRef="Cur_Select" />
    <bpmn:sequenceFlow id="Cur_F3" sourceRef="Cur_Select" targetRef="Cur_End" />
    <bpmn:sequenceFlow id="ProfessorCurso_IntoT1" sourceRef="ProfessorCurso_Start" targetRef="ProfessorCurso_T1" />
    <bpmn:sequenceFlow id="ProfessorCurso_IntoT2" sourceRef="ProfessorCurso_T1" targetRef="ProfessorCurso_T2" />
    <bpmn:sequenceFlow id="ProfessorCurso_IntoT3" sourceRef="ProfessorCurso_T2" targetRef="ProfessorCurso_T3" />
    <bpmn:sequenceFlow id="ProfessorCurso_Finish" sourceRef="ProfessorCurso_T3" targetRef="ProfessorCurso_End" />
    <bpmn:sequenceFlow id="AdminCurso_IntoT1" sourceRef="AdminCurso_Start" targetRef="AdminCurso_T1" />
    <bpmn:sequenceFlow id="AdminCurso_IntoT2" sourceRef="AdminCurso_T1" targetRef="AdminCurso_T2" />
    <bpmn:sequenceFlow id="AdminCurso_IntoT3" sourceRef="AdminCurso_T2" targetRef="AdminCurso_T3" />
    <bpmn:sequenceFlow id="AdminCurso_Finish" sourceRef="AdminCurso_T3" targetRef="AdminCurso_End" />
    <bpmn:sequenceFlow id="Temas_IntoT1" sourceRef="Temas_Start" targetRef="Temas_T1" />
    <bpmn:sequenceFlow id="Temas_IntoT2" sourceRef="Temas_T1" targetRef="Temas_T2" />
    <bpmn:sequenceFlow id="Temas_IntoT3" sourceRef="Temas_T2" targetRef="Temas_T3" />
    <bpmn:sequenceFlow id="Temas_Finish" sourceRef="Temas_T3" targetRef="Temas_End" />
  </bpmn:process>
  <bpmn:process id="Process_Modulos" name="Gestão de módulos" isExecutable="false">
    <bpmn:documentation>Gestão do professor em /professor/cursos/{idCurso}/modulos, com POST /api/cursos/{idCurso}/modulos e PUT/DELETE /api/modulos/{id}. O administrador consulta módulos; os alunos matriculados consultam módulos ativos. Fontes: backend/src/main/java/com/cursovalido/backend/aulas/service/ModuloService.java; frontend/src/componentes/aulas/PaginaGestaoCursos.jsx. Inventário exato de endpoints: GET /api/administracao/cursos/{idCurso}/modulos; GET /api/cursos/{idCurso}/modulos; GET /api/modulos/{id}; POST /api/cursos/{idCurso}/modulos; PUT /api/modulos/{id}; DELETE /api/modulos/{id}.</bpmn:documentation>
    <bpmn:startEvent id="Mod_Start" name="Professor acessa a gestão do curso">
      <bpmn:outgoing>Mod_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Mod_Input" name="Inserir os dados do módulo">
      <bpmn:incoming>Mod_F1</bpmn:incoming>
      <bpmn:outgoing>Mod_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Mod_Validate" name="Validar dados e acesso ao curso ativo de sua autoria">
      <bpmn:incoming>Mod_F2</bpmn:incoming>
      <bpmn:outgoing>Mod_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Mod_Save" name="Salvar módulo vinculado ao curso">
      <bpmn:incoming>Mod_F3</bpmn:incoming>
      <bpmn:outgoing>Mod_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Mod_End" name="Módulo cadastrado">
      <bpmn:incoming>Mod_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="EditarModulo_Start" name="Professor gerencia módulo existente">
      <bpmn:outgoing>EditarModulo_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="EditarModulo_T1" name="Consultar módulos do curso próprio">
      <bpmn:incoming>EditarModulo_IntoT1</bpmn:incoming>
      <bpmn:outgoing>EditarModulo_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="EditarModulo_T2" name="Editar os dados ou inativar módulo">
      <bpmn:incoming>EditarModulo_IntoT2</bpmn:incoming>
      <bpmn:outgoing>EditarModulo_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="EditarModulo_T3" name="Validar vínculo e registrar a alteração">
      <bpmn:incoming>EditarModulo_IntoT3</bpmn:incoming>
      <bpmn:outgoing>EditarModulo_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EditarModulo_End" name="Módulo atualizado">
      <bpmn:incoming>EditarModulo_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Mod_F1" sourceRef="Mod_Start" targetRef="Mod_Input" />
    <bpmn:sequenceFlow id="Mod_F2" sourceRef="Mod_Input" targetRef="Mod_Validate" />
    <bpmn:sequenceFlow id="Mod_F3" sourceRef="Mod_Validate" targetRef="Mod_Save" />
    <bpmn:sequenceFlow id="Mod_F4" sourceRef="Mod_Save" targetRef="Mod_End" />
    <bpmn:sequenceFlow id="EditarModulo_IntoT1" sourceRef="EditarModulo_Start" targetRef="EditarModulo_T1" />
    <bpmn:sequenceFlow id="EditarModulo_IntoT2" sourceRef="EditarModulo_T1" targetRef="EditarModulo_T2" />
    <bpmn:sequenceFlow id="EditarModulo_IntoT3" sourceRef="EditarModulo_T2" targetRef="EditarModulo_T3" />
    <bpmn:sequenceFlow id="EditarModulo_Finish" sourceRef="EditarModulo_T3" targetRef="EditarModulo_End" />
  </bpmn:process>
  <bpmn:process id="Process_Aulas" name="Aulas, provedores de vídeo e progresso" isExecutable="false">
    <bpmn:documentation>Professor: GET/POST /api/modulos/{idModulo}/aulas; GET/PUT/DELETE /api/aulas/{id}. Aluno: GET /api/aluno/aulas/{idAula}, GET/PUT /progresso e POST /conclusao. Administrador: GET/PUT /api/administracao/aulas/{id}, PUT /arquivar e /reabrir. Fontes: aulas/service/AulaService.java, AdministradorAulasService.java, VimeoService.java e ProgressoAulaService.java; frontend/src/componentes/aulas/PaginaAulaAluno.jsx e componentes/PlayerAula.jsx. Os dois vídeos são obrigatórios na criação/edição. Conclusão é manual e independe do tempo reproduzido; intervalo mínimo global de 5 minutos por aluno entre novas conclusões. Inventário exato de endpoints: GET /api/administracao/modulos/{id}/aulas; GET /api/administracao/aulas/{id}; PUT /api/administracao/aulas/{id}; PUT /api/administracao/aulas/{id}/arquivar; PUT /api/administracao/aulas/{id}/reabrir; GET /api/modulos/{idModulo}/aulas; GET /api/aulas/{id}; POST /api/modulos/{idModulo}/aulas; PUT /api/aulas/{id}; DELETE /api/aulas/{id}; GET /api/aluno/aulas/{idAula}/progresso; PUT /api/aluno/aulas/{idAula}/progresso; POST /api/aluno/aulas/{idAula}/conclusao. No backend, VimeoClient confirma uri e user.uri da conta autorizada; YoutubeClient verifica canal, processamento, incorporação e visibilidade. Falha de configuração ou consulta impede salvar. A verificação ocorre na gravação, sem revalidação automática das referências antigas. O navegador obtém o audiovisual diretamente dos provedores; a API armazena referências e progresso. Falhas tratadas do Vimeo permitem tentar o YouTube e retomar a última posição conhecida; isso não garante recuperação de toda falha. A troca do vídeo remove progresso anterior da aula, mas não estorna automaticamente XP já concedido. A conclusão é manual, com intervalo global de 5 minutos entre novas conclusões do aluno. A navegação segue a sequência de aulas carregada do curso.</bpmn:documentation>
    <bpmn:startEvent id="AulaProfessor_0" name="Professor cria ou edita aula de curso próprio">
      <bpmn:outgoing>Atual_Flow_59</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AulaProfessor_1" name="Validar módulo, curso ativo, autoria, título, descrição e ordem">
      <bpmn:incoming>Atual_Flow_59</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_60</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaProfessor_2" name="Validar HTTPS e consultar Vimeo e YouTube para confirmar conta e canal autorizados">
      <bpmn:incoming>Atual_Flow_60</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_61</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaProfessor_3" name="Exigir Vimeo válido e YouTube processado, público ou não listado e incorporável">
      <bpmn:incoming>Atual_Flow_61</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_182</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaProfessor_4" name="Limpar progresso se qualquer vídeo mudou; salvar aula e auditar">
      <bpmn:incoming>Atual_Flow_183</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_63</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AulaProfessor_5" name="Aula disponível">
      <bpmn:incoming>Atual_Flow_63</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="AulaWatch_0" name="Aluno abre aula do curso">
      <bpmn:outgoing>Atual_Flow_64</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AulaWatch_1" name="Validar matrícula, vínculo com curso e conteúdo ativo">
      <bpmn:incoming>Atual_Flow_64</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_65</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaWatch_2" name="Carregar progresso pela API e iniciar player Vimeo no navegador na posição salva">
      <bpmn:documentation>Responsabilidade: Frontend consulta a API; backend verifica acesso e retorna progresso; frontend inicia o player.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_65</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_66</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaWatch_3" name="Permitir seleção manual e tentar YouTube nas falhas do Vimeo tratadas pelo player">
      <bpmn:documentation>Responsabilidade: Frontend: player incorporado.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_66</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_67</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaWatch_4" name="Enviar posição à API a cada 10 s e ao pausar, terminar ou sair; repetir após falha">
      <bpmn:documentation>Responsabilidade: Frontend envia posição e trata falhas; backend valida matrícula e grava progresso.</bpmn:documentation>
      <bpmn:incoming>Atual_Flow_67</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_68</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AulaWatch_5" name="Posição disponível para retomada">
      <bpmn:incoming>Atual_Flow_68</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="AulaComplete_0" name="Aluno clica em marcar como concluída">
      <bpmn:outgoing>Atual_Flow_69</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AulaComplete_1" name="Validar aluno, matrícula e disponibilidade da aula">
      <bpmn:incoming>Atual_Flow_69</bpmn:incoming>
