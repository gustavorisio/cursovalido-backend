      <bpmn:outgoing>Term_F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Term_ReactiveSync" name="Sincronizar usuário com o fórum">
      <bpmn:incoming>Term_F10</bpmn:incoming>
      <bpmn:outgoing>Term_F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Term_AcceptAudit" name="Auditar aceite, emitir JWT de acesso e revogar sessões anteriores">
      <bpmn:incoming>Term_F11</bpmn:incoming>
      <bpmn:outgoing>Term_F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Term_AcceptEnd" name="Sessão autenticada emitida">
