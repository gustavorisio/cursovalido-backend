      <bpmn:outgoing>Atual_Flow_147</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Boot_Done" name="Inicialização já concluída?">
      <bpmn:incoming>Atual_Flow_147</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_148</bpmn:outgoing>
      <bpmn:outgoing>Atual_Flow_149</bpmn:outgoing>
    </bpmn:exclusiveGateway>
