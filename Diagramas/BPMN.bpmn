  <bpmn:process id="Process_Matriculas" name="Matrícula em curso gratuito" isExecutable="false">
    <bpmn:documentation>POST /api/aluno/cursos/{idCurso}/matriculas e GET /api/aluno/matriculas. O catálogo tem consulta pública, enquanto matrícula e aulas exigem perfil de aluno e validação no servidor. A API confere o e-mail e os termos aceitos, e devolve a matrícula anterior em solicitações repetidas. Fontes: backend/src/main/java/com/cursovalido/backend/aulas/service/AlunoAulasService.java; frontend/src/componentes/aulas/PaginaCatalogo.jsx; PaginaCursoAluno.jsx. Inventário exato de endpoints: GET /api/aluno/cursos; POST /api/aluno/cursos/{idCurso}/matriculas; GET /api/aluno/matriculas; GET /api/aluno/cursos/{idCurso}; GET /api/aluno/cursos/{idCurso}/modulos; GET /api/aluno/modulos/{idModulo}/aulas; GET /api/aluno/aulas/{idAula}.</bpmn:documentation>
    <bpmn:startEvent id="Mat_Start" name="Aluno confirma a intenção de matrícula no curso gratuito">
      <bpmn:outgoing>Mat_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Mat_CheckUser" name="Validar aluno ativo, e-mail confirmado, aceite e curso ativo">
      <bpmn:incoming>Mat_F1</bpmn:incoming>
      <bpmn:outgoing>Mat_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Mat_Active" name="Aluno e curso elegíveis?">
      <bpmn:incoming>Mat_F2</bpmn:incoming>
      <bpmn:outgoing>Mat_F3</bpmn:outgoing>
      <bpmn:outgoing>Mat_F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Mat_Register" name="Registrar e auditar inscrição nova ou devolver matrícula existente">
      <bpmn:incoming>Mat_F4</bpmn:incoming>
      <bpmn:outgoing>Mat_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Mat_Release" name="Disponibilizar módulos e aulas ativos ao aluno">
      <bpmn:incoming>Mat_F5</bpmn:incoming>
      <bpmn:outgoing>Mat_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Mat_End" name="Aluno matriculado e acesso liberado">
      <bpmn:incoming>Mat_F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Mat_Denied" name="Matrícula não permitida">
      <bpmn:incoming>Mat_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="MinhasMatriculas_Start" name="Aluno abre seus cursos">
      <bpmn:outgoing>MinhasMatriculas_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="MinhasMatriculas_T1" name="Consultar matrículas do aluno">
      <bpmn:incoming>MinhasMatriculas_IntoT1</bpmn:incoming>
      <bpmn:outgoing>MinhasMatriculas_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="MinhasMatriculas_T2" name="Exibir cursos e disponibilidade">
      <bpmn:incoming>MinhasMatriculas_IntoT2</bpmn:incoming>
      <bpmn:outgoing>MinhasMatriculas_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="MinhasMatriculas_End" name="Matrículas exibidas">
      <bpmn:incoming>MinhasMatriculas_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ConteudoMatriculado_Start" name="Aluno acessa um curso em que está matriculado">
      <bpmn:outgoing>ConteudoMatriculado_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="ConteudoMatriculado_T1" name="Verificar matrícula e consultar módulos e aulas ativos">
      <bpmn:incoming>ConteudoMatriculado_IntoT1</bpmn:incoming>
      <bpmn:outgoing>ConteudoMatriculado_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ConteudoMatriculado_T2" name="Carregar progresso de cada aula e calcular o percentual de conclusão">
      <bpmn:incoming>ConteudoMatriculado_IntoT2</bpmn:incoming>
      <bpmn:outgoing>ConteudoMatriculado_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ConteudoMatriculado_T3" name="Exibir aulas, pesquisa por nome e acesso ao plano de estudos">
      <bpmn:incoming>ConteudoMatriculado_IntoT3</bpmn:incoming>
      <bpmn:outgoing>ConteudoMatriculado_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ConteudoMatriculado_End" name="Conteúdo e progresso do curso exibidos">
      <bpmn:incoming>ConteudoMatriculado_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Mat_F1" sourceRef="Mat_Start" targetRef="Mat_CheckUser" />
    <bpmn:sequenceFlow id="Mat_F2" sourceRef="Mat_CheckUser" targetRef="Mat_Active" />
    <bpmn:sequenceFlow id="Mat_F3" name="Não" sourceRef="Mat_Active" targetRef="Mat_Denied" />
    <bpmn:sequenceFlow id="Mat_F4" name="Sim" sourceRef="Mat_Active" targetRef="Mat_Register" />
    <bpmn:sequenceFlow id="Mat_F5" sourceRef="Mat_Register" targetRef="Mat_Release" />
    <bpmn:sequenceFlow id="Mat_F6" sourceRef="Mat_Release" targetRef="Mat_End" />
    <bpmn:sequenceFlow id="MinhasMatriculas_IntoT1" sourceRef="MinhasMatriculas_Start" targetRef="MinhasMatriculas_T1" />
    <bpmn:sequenceFlow id="MinhasMatriculas_IntoT2" sourceRef="MinhasMatriculas_T1" targetRef="MinhasMatriculas_T2" />
    <bpmn:sequenceFlow id="MinhasMatriculas_Finish" sourceRef="MinhasMatriculas_T2" targetRef="MinhasMatriculas_End" />
    <bpmn:sequenceFlow id="ConteudoMatriculado_IntoT1" sourceRef="ConteudoMatriculado_Start" targetRef="ConteudoMatriculado_T1" />
    <bpmn:sequenceFlow id="ConteudoMatriculado_IntoT2" sourceRef="ConteudoMatriculado_T1" targetRef="ConteudoMatriculado_T2" />
    <bpmn:sequenceFlow id="ConteudoMatriculado_IntoT3" sourceRef="ConteudoMatriculado_T2" targetRef="ConteudoMatriculado_T3" />
    <bpmn:sequenceFlow id="ConteudoMatriculado_Finish" sourceRef="ConteudoMatriculado_T3" targetRef="ConteudoMatriculado_End" />
  </bpmn:process>
  <bpmn:process id="Process_Suporte" name="Suporte público" isExecutable="false">
    <bpmn:documentation>Formulário público /suporte e POST /api/suporte/solicitacoes. Solicitação sujeita à validação, configuração de e-mail e limites de envio. Fontes: backend/src/main/java/com/cursovalido/backend/authentication/suporte/SuporteController.java; LimiteSuporteService.java; frontend/src/componentes/suporte/PaginaSuporte.jsx. Inventário exato de endpoints: POST /api/suporte/solicitacoes. Backend: bloqueio por IP/e-mail durante 1 hora após envio concluído. Falha no Resend desfaz a transação sem consumir cota. Frontend: a mensagem LIMITE_SUPORTE_ATINGIDO (servicos/api.js) e a orientação da tela PaginaSuporte.jsx ainda informam 24 horas; esta divergência é registrada, sem converter a mensagem da interface em regra do servidor. Protocolo retorna apenas quando o encaminhamento tem sucesso. Não é chat nem validação de identidade.</bpmn:documentation>
    <bpmn:startEvent id="SolicitarSuporte_Start" name="Visitante ou usuário abre suporte">
      <bpmn:outgoing>SolicitarSuporte_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="SolicitarSuporte_T1" name="Preencher e-mail da conta, usuário, motivo, assunto e descrição">
      <bpmn:documentation>Responsabilidade: Usuário preenche formulário no frontend.</bpmn:documentation>
      <bpmn:incoming>SolicitarSuporte_IntoT1</bpmn:incoming>
      <bpmn:outgoing>SolicitarSuporte_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SolicitarSuporte_T2" name="Validar campos, destinatário e limite de 1 hora por IP ou e-mail no backend">
      <bpmn:incoming>SolicitarSuporte_IntoT2</bpmn:incoming>
      <bpmn:outgoing>SolicitarSuporte_Check2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="SolicitarSuporte_G2" name="Envio permitido?">
      <bpmn:incoming>SolicitarSuporte_Check2</bpmn:incoming>
      <bpmn:outgoing>SolicitarSuporte_Fail2</bpmn:outgoing>
      <bpmn:outgoing>SolicitarSuporte_IntoT3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="SolicitarSuporte_E2" name="Solicitação recusada">
      <bpmn:incoming>SolicitarSuporte_Fail2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="SolicitarSuporte_T3" name="Gerar protocolo e enviar via Resend; consumir limite somente após sucesso">
      <bpmn:incoming>SolicitarSuporte_IntoT3</bpmn:incoming>
      <bpmn:outgoing>SolicitarSuporte_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SolicitarSuporte_End" name="Protocolo exibido">
      <bpmn:incoming>SolicitarSuporte_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SolicitarSuporte_IntoT1" sourceRef="SolicitarSuporte_Start" targetRef="SolicitarSuporte_T1" />
    <bpmn:sequenceFlow id="SolicitarSuporte_IntoT2" sourceRef="SolicitarSuporte_T1" targetRef="SolicitarSuporte_T2" />
    <bpmn:sequenceFlow id="SolicitarSuporte_Check2" sourceRef="SolicitarSuporte_T2" targetRef="SolicitarSuporte_G2" />
    <bpmn:sequenceFlow id="SolicitarSuporte_Fail2" name="Não" sourceRef="SolicitarSuporte_G2" targetRef="SolicitarSuporte_E2" />
    <bpmn:sequenceFlow id="SolicitarSuporte_IntoT3" name="Sim" sourceRef="SolicitarSuporte_G2" targetRef="SolicitarSuporte_T3" />
    <bpmn:sequenceFlow id="SolicitarSuporte_Finish" sourceRef="SolicitarSuporte_T3" targetRef="SolicitarSuporte_End" />
  </bpmn:process>
  <bpmn:process id="Process_Aprendizagem" name="Avaliações de curso, questionários e plano de estudos" isExecutable="false">
    <bpmn:documentation>Aluno: GET /api/aluno/cursos/{idCurso}/diagnostico e /modulos/{idModulo}/questionario; POST sob essas rotas em /respostas; GET /api/aluno/cursos/{idCurso}/plano. Gestão: GET/PUT /api/professor/cursos/{idCurso}/diagnostico e /modulos/{idModulo}/questionario e equivalentes /api/administracao. Fontes: aulas/service/QuestionarioService.java e dto/QuestionarioRequest.java; frontend/src/componentes/aulas/PaginaQuestionarioAluno.jsx, PaginaEditorQuestionario.jsx e componentes/PlanoEstudos.jsx. Plano contém avaliações e última pontuação da versão vigente; recomendações retornam lista vazia. Questionários não bloqueiam aulas nem determinam XP. Inventário exato de endpoints: GET /api/professor/cursos/{idCurso}/diagnostico; GET /api/administracao/cursos/{idCurso}/diagnostico; GET /api/professor/cursos/{idCurso}/modulos/{idModulo}/questionario; GET /api/administracao/cursos/{idCurso}/modulos/{idModulo}/questionario; PUT /api/professor/cursos/{idCurso}/diagnostico; PUT /api/administracao/cursos/{idCurso}/diagnostico; PUT /api/professor/cursos/{idCurso}/modulos/{idModulo}/questionario; PUT /api/administracao/cursos/{idCurso}/modulos/{idModulo}/questionario; GET /api/aluno/cursos/{idCurso}/diagnostico; GET /api/aluno/cursos/{idCurso}/modulos/{idModulo}/questionario; POST /api/aluno/cursos/{idCurso}/diagnostico/respostas; POST /api/aluno/cursos/{idCurso}/modulos/{idModulo}/questionario/respostas; GET /api/aluno/cursos/{idCurso}/plano. Cada avaliação possui versão; respostas incompletas, alternativas inválidas e versão desatualizada são recusadas. Não são emitidos certificados. O campo de aula de revisão não gera recomendações nesta versão. Não se acrescenta fluxo futuro de revisão automática.</bpmn:documentation>
    <bpmn:startEvent id="AvaliacaoManage_0" name="Professor autor ou administrador abre editor">
      <bpmn:outgoing>Atual_Flow_81</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AvaliacaoManage_1" name="Validar curso e módulo ativos e permissão de gestão">
      <bpmn:incoming>Atual_Flow_81</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_82</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoManage_2" name="Editar título, perguntas, alternativas, resposta correta e explicação">
      <bpmn:incoming>Atual_Flow_82</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_83</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoManage_3" name="Validar limites: curso até 10 perguntas; módulo até 30; salvar rascunho ou publicação">
      <bpmn:incoming>Atual_Flow_83</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_84</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoManage_4" name="Incrementar versão em edição e auditar">
      <bpmn:incoming>Atual_Flow_84</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_85</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AvaliacaoManage_5" name="Avaliação atualizada">
      <bpmn:incoming>Atual_Flow_85</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="AvaliacaoAluno_0" name="Aluno matriculado abre avaliação de curso ou módulo">
      <bpmn:outgoing>Atual_Flow_86</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="AvaliacaoAluno_1" name="Validar acesso ao curso e módulo; consultar questionário publicado com perguntas">
      <bpmn:incoming>Atual_Flow_86</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_87</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoAluno_2" name="Recuperar última tentativa da versão vigente, se houver">
      <bpmn:incoming>Atual_Flow_87</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_88</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoAluno_3" name="Enviar todas as respostas com a versão consultada">
      <bpmn:incoming>Atual_Flow_88</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_89</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoAluno_4" name="Recusar versão desatualizada ou alternativas inválidas; calcular acertos e percentual">
      <bpmn:incoming>Atual_Flow_89</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_90</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AvaliacaoAluno_5" name="Salvar nova tentativa e devolver correções e explicações">
      <bpmn:incoming>Atual_Flow_90</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_91</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AvaliacaoAluno_6" name="Exibir resultado e permitir refazer avaliação">
      <bpmn:incoming>Atual_Flow_91</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Plano_0" name="Aluno consulta plano de estudos">
      <bpmn:outgoing>Atual_Flow_92</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Plano_1" name="Validar matrícula e curso ativo">
      <bpmn:incoming>Atual_Flow_92</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_93</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Plano_2" name="Listar avaliações publicadas com perguntas e módulos ativos">
      <bpmn:incoming>Atual_Flow_93</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_94</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Plano_3" name="Consultar percentual da última tentativa na versão vigente">
      <bpmn:incoming>Atual_Flow_94</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_95</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Plano_4" name="Exibir pendências, pontuações e links para responder ou refazer">
      <bpmn:incoming>Atual_Flow_95</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Atual_Flow_81" sourceRef="AvaliacaoManage_0" targetRef="AvaliacaoManage_1" />
    <bpmn:sequenceFlow id="Atual_Flow_82" sourceRef="AvaliacaoManage_1" targetRef="AvaliacaoManage_2" />
