      <bpmn:outgoing>Atual_Flow_73</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AulaComplete_5" name="Exibir conclusão e eventual recompensa ou subida de nível">
      <bpmn:incoming>Atual_Flow_73</bpmn:incoming>
    </bpmn:endEvent>
