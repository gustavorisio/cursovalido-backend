  <bpmn:process id="Process_FrontendSessao" name="Frontend React navegação, sessão e comunicação HTTP" isExecutable="false">
    <bpmn:documentation>Fluxos transversais existentes. Fontes: frontend/src/componentes/autenticacao/RotaProtegida.jsx; contextos/AutenticacaoContexto.jsx; servicos/sessaoNavegador.js; servicos/api.js; contextos/useAcaoUnica.js. A autorização efetiva permanece no backend. O frontend não contém credenciais de Resend, Vimeo Data API ou YouTube Data API. VITE_API_URL fornece a base da API no build. Rotas protegidas levam o visitante ao login e perfil incompatível a /cursos. A sincronização usa o evento storage e a sessão persistida. Expiração e 401 só invalidam a sessão correspondente ao token afetado. Respostas de uma conta anterior não podem repor sessão ou atualizar os dados da conta atual.</bpmn:documentation>
    <bpmn:startEvent id="FrontNav_Start" name="Acessar rota protegida">
      <bpmn:outgoing>FrontNav_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="FrontNav_Validar" name="Ler sessão persistida e conferir expiração do JWT">
      <bpmn:incoming>FrontNav_F1</bpmn:incoming>
      <bpmn:outgoing>FrontNav_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="FrontNav_Sessao" name="Sessão válida?">
      <bpmn:incoming>FrontNav_F2</bpmn:incoming>
      <bpmn:outgoing>FrontNav_F3</bpmn:outgoing>
      <bpmn:outgoing>FrontNav_F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="FrontNav_Perfil" name="Perfil permitido?">
      <bpmn:incoming>FrontNav_F3</bpmn:incoming>
      <bpmn:outgoing>FrontNav_F4</bpmn:outgoing>
      <bpmn:outgoing>FrontNav_F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="FrontNav_Liberar" name="Liberar página e iniciar consultas à API">
      <bpmn:incoming>FrontNav_F4</bpmn:incoming>
      <bpmn:outgoing>FrontNav_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontNav_Fim" name="Página disponível">
      <bpmn:incoming>FrontNav_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="FrontNav_Login" name="Redirecionar ao login preservando o caminho de origem">
      <bpmn:incoming>FrontNav_F6</bpmn:incoming>
      <bpmn:outgoing>FrontNav_F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontNav_LoginEnd" name="Aguardar login">
      <bpmn:incoming>FrontNav_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="FrontNav_Catalogo" name="Redirecionar para /cursos">
      <bpmn:incoming>FrontNav_F8</bpmn:incoming>
      <bpmn:outgoing>FrontNav_F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontNav_DeniedEnd" name="Área não liberada">
      <bpmn:incoming>FrontNav_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FrontSync_0" name="Outra aba altera a sessão">
      <bpmn:outgoing>FrontSync_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="FrontSync_1" name="Receber evento storage e reler sessão persistida">
      <bpmn:incoming>FrontSync_F1</bpmn:incoming>
      <bpmn:outgoing>FrontSync_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontSync_2" name="Invalidar tentativa de autenticação anterior e atualizar conta em uso">
      <bpmn:incoming>FrontSync_F2</bpmn:incoming>
      <bpmn:outgoing>FrontSync_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontSync_3" name="Atualizar páginas, permissões e dados da sessão corrente">
      <bpmn:incoming>FrontSync_F3</bpmn:incoming>
      <bpmn:outgoing>FrontSync_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontSync_4" name="Abas sincronizadas">
      <bpmn:incoming>FrontSync_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FrontExpira_0" name="JWT expira ou API responde 401">
      <bpmn:outgoing>FrontExpira_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="FrontExpira_1" name="Conferir token afetado para não encerrar outra sessão já iniciada">
      <bpmn:incoming>FrontExpira_F1</bpmn:incoming>
      <bpmn:outgoing>FrontExpira_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontExpira_2" name="Limpar sessão local e descartar resultados da tentativa anterior">
      <bpmn:incoming>FrontExpira_F2</bpmn:incoming>
      <bpmn:outgoing>FrontExpira_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontExpira_3" name="Reavaliar acesso às páginas protegidas">
      <bpmn:incoming>FrontExpira_F3</bpmn:incoming>
      <bpmn:outgoing>FrontExpira_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontExpira_4" name="Novo login necessário">
      <bpmn:incoming>FrontExpira_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FrontHttp_0" name="Usuário envia operação">
      <bpmn:outgoing>FrontHttp_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="FrontHttp_1" name="Compartilhar envio idêntico já em andamento; impedir duplo processamento na interface">
      <bpmn:incoming>FrontHttp_F1</bpmn:incoming>
      <bpmn:outgoing>FrontHttp_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontHttp_2" name="Montar JSON e anexar Bearer válido quando a operação usa autenticação">
      <bpmn:incoming>FrontHttp_F2</bpmn:incoming>
      <bpmn:outgoing>FrontHttp_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontHttp_3" name="Executar fetch; descartar resposta se a sessão tiver mudado">
      <bpmn:incoming>FrontHttp_F3</bpmn:incoming>
      <bpmn:outgoing>FrontHttp_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontHttp_4" name="Tratar sucesso, erro, restrições e evento de documentos atualizados">
      <bpmn:incoming>FrontHttp_F4</bpmn:incoming>
      <bpmn:outgoing>FrontHttp_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontHttp_5" name="Interface atualizada">
      <bpmn:incoming>FrontHttp_F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="FrontAuthResposta_0" name="Retorno de login ou confirmação">
      <bpmn:outgoing>FrontAuthResposta_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="FrontAuthResposta_1" name="Comparar geração da tentativa com a autenticação ainda em andamento">
      <bpmn:incoming>FrontAuthResposta_F1</bpmn:incoming>
      <bpmn:outgoing>FrontAuthResposta_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="FrontAuthResposta_2" name="Guardar somente resposta atual; se abandonada, descartar e revogar JWT recebido">
      <bpmn:incoming>FrontAuthResposta_F2</bpmn:incoming>
      <bpmn:outgoing>FrontAuthResposta_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="FrontAuthResposta_3" name="Sessão atual preservada">
      <bpmn:incoming>FrontAuthResposta_F3</bpmn:incoming>
    </bpmn:endEvent>
