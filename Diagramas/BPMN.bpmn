      <bpmn:outgoing>Atual_Flow_78</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaAdmin_2" name="Editar com os dois vídeos ou arquivar ou reabrir a aula">
      <bpmn:incoming>Atual_Flow_78</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_79</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="AulaAdmin_3" name="Limpar progresso se vídeo mudou; persistir e auditar">
      <bpmn:incoming>Atual_Flow_79</bpmn:incoming>
      <bpmn:outgoing>Atual_Flow_80</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="AulaAdmin_4" name="Aula atualizada">
