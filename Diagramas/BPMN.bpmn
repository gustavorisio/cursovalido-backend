      <bpmn:outgoing>Atual_Flow_98</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ModList_3" name="Exibir usuários">
      <bpmn:incoming>Atual_Flow_98</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="ModSuspend_0" name="Administrador solicita suspensão">
