  <bpmn:process id="Process_Politicas" name="Consulta e publicação de políticas" isExecutable="false">
    <bpmn:documentation>Consulta pública de termos, privacidade e responsabilidade por perfil. GET /api/politicas/ativas, /api/politicas/privacidade/ativa e /api/politicas/responsabilidade/{perfil}. POST /api/politicas e /api/politicas/privacidade, restritos ao administrador principal. Fontes: backend/src/main/java/com/cursovalido/backend/authentication/service/PoliticaService.java; authentication/service/PrivacidadeService.java; authentication/service/ResponsabilidadeService.java; frontend/src/paginas/Administracao.jsx; paginas/TermosDeUso.jsx; paginas/PoliticaDePrivacidade.jsx. Inventário exato de endpoints: GET /politica-privacidade.html; GET /termos-aceite.html; GET /api/politicas/privacidade/ativa; POST /api/politicas/privacidade; GET /api/politicas/ativas; POST /api/politicas; GET /api/politicas/responsabilidade/{perfil}.</bpmn:documentation>
    <bpmn:startEvent id="Pol_StartAdmin" name="Administrador principal publica termos ou privacidade">
      <bpmn:outgoing>Pol_F4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pol_Validate" name="Verificar privilégio e validar conteúdo do documento">
      <bpmn:incoming>Pol_F4</bpmn:incoming>
      <bpmn:outgoing>Pol_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pol_Deactivate" name="Gerar a próxima versão do documento">
      <bpmn:incoming>Pol_F5</bpmn:incoming>
      <bpmn:outgoing>Pol_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pol_Affected" name="Desativar a versão anterior do documento">
      <bpmn:incoming>Pol_F6</bpmn:incoming>
      <bpmn:outgoing>Pol_F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pol_Save" name="Salvar a nova versão ativa">
      <bpmn:incoming>Pol_F7</bpmn:incoming>
      <bpmn:outgoing>Pol_F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pol_Audit" name="Auditar publicação. A versão vigente será verificada no login">
      <bpmn:incoming>Pol_F8</bpmn:incoming>
      <bpmn:outgoing>Pol_F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pol_AdminEnd" name="Publicação concluída">
      <bpmn:incoming>Pol_F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Pol_PublicEnd" name="Consulta pública concluída">
      <bpmn:incoming>Pol_F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pol_Return" name="Retornar políticas vigentes">
      <bpmn:incoming>Pol_F2</bpmn:incoming>
      <bpmn:outgoing>Pol_F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pol_QueryActive" name="Consultar somente políticas ativas">
      <bpmn:incoming>Pol_F1</bpmn:incoming>
      <bpmn:outgoing>Pol_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Pol_StartPublic" name="Visitante consulta as políticas ativas">
      <bpmn:outgoing>Pol_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Pol_F4" sourceRef="Pol_StartAdmin" targetRef="Pol_Validate" />
    <bpmn:sequenceFlow id="Pol_F5" sourceRef="Pol_Validate" targetRef="Pol_Deactivate" />
    <bpmn:sequenceFlow id="Pol_F6" sourceRef="Pol_Deactivate" targetRef="Pol_Affected" />
    <bpmn:sequenceFlow id="Pol_F7" sourceRef="Pol_Affected" targetRef="Pol_Save" />
    <bpmn:sequenceFlow id="Pol_F8" sourceRef="Pol_Save" targetRef="Pol_Audit" />
    <bpmn:sequenceFlow id="Pol_F9" sourceRef="Pol_Audit" targetRef="Pol_AdminEnd" />
    <bpmn:sequenceFlow id="Pol_F3" sourceRef="Pol_Return" targetRef="Pol_PublicEnd" />
    <bpmn:sequenceFlow id="Pol_F2" sourceRef="Pol_QueryActive" targetRef="Pol_Return" />
    <bpmn:sequenceFlow id="Pol_F1" sourceRef="Pol_StartPublic" targetRef="Pol_QueryActive" />
  </bpmn:process>
  <bpmn:process id="Process_Convites" name="Convites de equipe e pendências legadas" isExecutable="false">
    <bpmn:documentation>Telas /administracao/convites e /convites/cadastro. POST /api/convites/consultar e /completar-cadastro. Gestão em /api/administracao/convites: GET base e /pendentes; POST base, /{id}/aprovar, /{id}/rejeitar e /{id}/reenviar; DELETE /{id} e /{id}/cancelar. GET /auditoria/integridade. Fontes: authentication/service/ConviteAcessoService.java, validation/convite/ConviteValidation.java, validation/administracao/PrivilegiosAdministrativosService.java; frontend/src/paginas/Administracao.jsx e CadastroConvite.jsx. Administrador comum gerencia PROFESSOR; somente principal gerencia ADMINISTRADOR. Novos cadastros dispensam aprovação; o painel mantém decisões para pendências anteriores. Não há endpoint de confirmar e-mail do convite. Inventário exato de endpoints: GET /api/administracao/convites/auditoria/integridade; POST /api/administracao/convites; GET /api/administracao/convites/pendentes; GET /api/administracao/convites; POST /api/administracao/convites/{id}/aprovar; POST /api/administracao/convites/{id}/rejeitar; DELETE /api/administracao/convites/{id}; POST /api/administracao/convites/{id}/reenviar; DELETE /api/administracao/convites/{id}/cancelar; POST /api/convites/consultar; POST /api/convites/completar-cadastro. Pendências legadas mantidas porque existem botões Aprovar/Rejeitar no painel e endpoints correspondentes. Novos convites concluídos geram conta já aprovada. A integridade da auditoria é restrita ao principal e consultável pela API; não é adicionada uma tela inexistente para esse endpoint.</bpmn:documentation>
