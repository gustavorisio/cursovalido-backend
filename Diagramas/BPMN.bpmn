    </bpmn:endEvent>
    <bpmn:startEvent id="SolicitarExclusao_Start" name="Usuário solicita excluir a conta">
      <bpmn:outgoing>SolicitarExclusao_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="SolicitarExclusao_T1" name="Identificar conta de aluno ou professor e validar limite de envio">
