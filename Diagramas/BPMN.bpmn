      <bpmn:outgoing>Atual_Flow_151</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Boot_EndExisting" name="Criação inicial encerrada">
      <bpmn:incoming>Atual_Flow_151</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Boot_Config" name="E-mail e senha ambos vazios?">
