  <bpmn:process id="Process_Senha" name="Recuperação e alteração de senha" isExecutable="false">
    <bpmn:documentation>Telas /solicitar-alteracao-senha, /redefinir-senha e /configuracoes/alterar-senha. POST /api/autenticacao/solicitar-alteracao-senha, /api/autenticacao/alterar-senha e /api/autenticacao/alterar-senha-autenticado. Fontes: backend/src/main/java/com/cursovalido/backend/authentication/service/SenhaUsuarioService.java; frontend/src/paginas/SolicitarAlteracaoSenha.jsx; paginas/AlterarSenha.jsx; paginas/AlterarSenhaConta.jsx. Inventário exato de endpoints: POST /api/autenticacao/solicitar-alteracao-senha; POST /api/autenticacao/alterar-senha; POST /api/autenticacao/alterar-senha-autenticado.</bpmn:documentation>
    <bpmn:startEvent id="Pass_StartRequest" name="Usuário solicita alteração de senha informando o e-mail">
      <bpmn:outgoing>Pass_F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pass_Find" name="Localizar conta ativa">
      <bpmn:incoming>Pass_F1</bpmn:incoming>
      <bpmn:outgoing>Pass_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Pass_Exists" name="Conta ativa encontrada?">
      <bpmn:incoming>Pass_F2</bpmn:incoming>
      <bpmn:outgoing>Pass_F3</bpmn:outgoing>
      <bpmn:outgoing>Pass_F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Pass_Silent" name="Resposta silenciosa para inexistente/inativa">
      <bpmn:incoming>Pass_F3</bpmn:incoming>
      <bpmn:outgoing>Pass_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pass_SilentEnd" name="Resposta sem revelar existência">
      <bpmn:incoming>Pass_F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pass_Token" name="Gerar token de alteração com validade de 30 minutos">
      <bpmn:incoming>Pass_F5</bpmn:incoming>
      <bpmn:outgoing>Pass_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pass_Send" name="Enviar link de alteração">
      <bpmn:incoming>Pass_F6</bpmn:incoming>
      <bpmn:outgoing>Pass_F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pass_RequestEnd" name="Solicitação concluída">
      <bpmn:incoming>Pass_F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Pass_StartChange" name="Usuário envia o token e a nova senha">
      <bpmn:outgoing>Pass_F8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Pass_ValidateChange" name="Validar senha e confirmação">
      <bpmn:incoming>Pass_F8</bpmn:incoming>
      <bpmn:outgoing>Pass_F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Pass_TokenValid" name="Senhas iguais e válidas?">
      <bpmn:incoming>Pass_F9</bpmn:incoming>
      <bpmn:outgoing>Pass_F10</bpmn:outgoing>
      <bpmn:outgoing>Pass_F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Pass_TokenError" name="Nova senha recusada">
      <bpmn:incoming>Pass_F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pass_CheckPassword" name="Validar token, finalidade, validade e uso único">
      <bpmn:incoming>Pass_F11</bpmn:incoming>
      <bpmn:outgoing>Pass_F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Pass_PasswordEqual" name="Token válido?">
      <bpmn:incoming>Pass_F12</bpmn:incoming>
      <bpmn:outgoing>Pass_F13</bpmn:outgoing>
      <bpmn:outgoing>Pass_F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Pass_PasswordError" name="Token recusado">
      <bpmn:incoming>Pass_F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Pass_Bcrypt" name="Salvar senha com BCrypt e revogar sessões e códigos">
      <bpmn:incoming>Pass_F14</bpmn:incoming>
      <bpmn:outgoing>Pass_F15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Pass_Audit" name="Auditar ALTERACAO_SENHA">
      <bpmn:incoming>Pass_F15</bpmn:incoming>
      <bpmn:outgoing>Pass_F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Pass_ChangeEnd" name="Senha alterada">
      <bpmn:incoming>Pass_F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SenhaAtual_Start" name="Usuário altera a senha nas configurações">
      <bpmn:outgoing>SenhaAtual_IntoT1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="SenhaAtual_T1" name="Validar senha atual, nova senha e confirmação">
      <bpmn:incoming>SenhaAtual_IntoT1</bpmn:incoming>
      <bpmn:outgoing>SenhaAtual_IntoT2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SenhaAtual_T2" name="Salvar senha com BCrypt">
      <bpmn:incoming>SenhaAtual_IntoT2</bpmn:incoming>
      <bpmn:outgoing>SenhaAtual_IntoT3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SenhaAtual_T3" name="Revogar sessões e códigos, e auditar">
      <bpmn:incoming>SenhaAtual_IntoT3</bpmn:incoming>
      <bpmn:outgoing>SenhaAtual_Finish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="SenhaAtual_End" name="Senha alterada">
      <bpmn:incoming>SenhaAtual_Finish</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Pass_F1" sourceRef="Pass_StartRequest" targetRef="Pass_Find" />
    <bpmn:sequenceFlow id="Pass_F2" sourceRef="Pass_Find" targetRef="Pass_Exists" />
    <bpmn:sequenceFlow id="Pass_F3" name="Não" sourceRef="Pass_Exists" targetRef="Pass_Silent" />
    <bpmn:sequenceFlow id="Pass_F5" name="Sim" sourceRef="Pass_Exists" targetRef="Pass_Token" />
    <bpmn:sequenceFlow id="Pass_F4" sourceRef="Pass_Silent" targetRef="Pass_SilentEnd" />
    <bpmn:sequenceFlow id="Pass_F6" sourceRef="Pass_Token" targetRef="Pass_Send" />
    <bpmn:sequenceFlow id="Pass_F7" sourceRef="Pass_Send" targetRef="Pass_RequestEnd" />
    <bpmn:sequenceFlow id="Pass_F8" sourceRef="Pass_StartChange" targetRef="Pass_ValidateChange" />
    <bpmn:sequenceFlow id="Pass_F9" sourceRef="Pass_ValidateChange" targetRef="Pass_TokenValid" />
    <bpmn:sequenceFlow id="Pass_F10" name="Não" sourceRef="Pass_TokenValid" targetRef="Pass_TokenError" />
    <bpmn:sequenceFlow id="Pass_F11" name="Sim" sourceRef="Pass_TokenValid" targetRef="Pass_CheckPassword" />
    <bpmn:sequenceFlow id="Pass_F12" sourceRef="Pass_CheckPassword" targetRef="Pass_PasswordEqual" />
    <bpmn:sequenceFlow id="Pass_F13" name="Não" sourceRef="Pass_PasswordEqual" targetRef="Pass_PasswordError" />
    <bpmn:sequenceFlow id="Pass_F14" name="Sim" sourceRef="Pass_PasswordEqual" targetRef="Pass_Bcrypt" />
    <bpmn:sequenceFlow id="Pass_F15" sourceRef="Pass_Bcrypt" targetRef="Pass_Audit" />
    <bpmn:sequenceFlow id="Pass_F16" sourceRef="Pass_Audit" targetRef="Pass_ChangeEnd" />
    <bpmn:sequenceFlow id="SenhaAtual_IntoT1" sourceRef="SenhaAtual_Start" targetRef="SenhaAtual_T1" />
    <bpmn:sequenceFlow id="SenhaAtual_IntoT2" sourceRef="SenhaAtual_T1" targetRef="SenhaAtual_T2" />
    <bpmn:sequenceFlow id="SenhaAtual_IntoT3" sourceRef="SenhaAtual_T2" targetRef="SenhaAtual_T3" />
    <bpmn:sequenceFlow id="SenhaAtual_Finish" sourceRef="SenhaAtual_T3" targetRef="SenhaAtual_End" />
  </bpmn:process>
  <bpmn:process id="Process_Termos" name="Termos, conta e exclusão" isExecutable="false">
    <bpmn:documentation>Tela /configuracoes e decisão de documentos no login; GET /api/autenticacao/meus-dados e /exportar-dados; PUT /segundo-fator; POST /revogar-termos, /aceitar-termos-novamente, /decidir-termos e /conta/solicitar-exclusao; DELETE /conta. Fontes: authentication/service/ContaUsuarioService.java, TermosUsuarioService.java, configuration/TokenJwtFilter.java e controller/AutenticacaoController.java; frontend/src/paginas/Configuracoes.jsx, TermosDeUso.jsx e componentes/autenticacao/DadosUsuario.jsx. Aluno pode ativar/desativar 2FA; equipe não pode desativar. Autoexclusão somente para aluno/professor; administrador é removido pelo principal e o principal é protegido. Exportação omite auditoria. Sessão comum desatualizada exige novo login antes do aceite pelo JWT restrito; login pode ocorrer com ou sem código. Inventário exato de endpoints: GET /api/autenticacao/meus-dados; PUT /api/autenticacao/segundo-fator; GET /api/autenticacao/exportar-dados; POST /api/autenticacao/revogar-termos; POST /api/autenticacao/decidir-termos; POST /api/autenticacao/aceitar-termos-novamente; POST /api/autenticacao/conta/solicitar-exclusao; DELETE /api/autenticacao/conta. A exclusão desidentifica a conta, remove credenciais, tokens e sessões e retira referência pessoal da auditoria. Aceites arquivados, hash do e-mail, gamertag e histórico do fórum permanecem conforme a implementação; não há garantia de anonimização irreversível. A autoexclusão é apenas para aluno e professor. Fontes: ContaUsuarioService.java e IdentidadeExcluidaService.java.</bpmn:documentation>
    <bpmn:task id="Term_RevAudit" name="Auditar revogação">
      <bpmn:incoming>Term_F3</bpmn:incoming>
      <bpmn:outgoing>Term_F4</bpmn:outgoing>
    </bpmn:task>
